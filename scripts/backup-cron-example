# 30 2 * * 0 docker compose -f /opt/tms/docker-compose.prod.yml exec -T postgres \
#            psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "VACUUM (ANALYZE) events, temperature_readings, trips;"
