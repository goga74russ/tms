# ============================================================
# TMS v2 — environment template
# ============================================================
# Copy to .env and replace every CHANGE_ME_* value before any
# real deployment. CHANGE_ME_* values are intentionally invalid
# so production never accidentally boots with a default secret.
#
# Vars are grouped by:
#   1. Required for boot (compose will refuse to start without them)
#   2. Required for production hardening (security defaults)
#   3. Optional integrations (work in mock mode if unset)
#   4. Tunables (have sensible defaults, override per environment)
# ============================================================


# ============================================================
# 1. REQUIRED — compose will refuse to start without these.
# ============================================================

# --- Public URL & networking ------------------------------------------------
# Used by web + API for absolute URL generation, CORS, cookies.
TMS_PUBLIC_HOST=localhost
TMS_PUBLIC_SCHEME=http
DOMAIN=localhost
CORS_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
INTERNAL_API_URL=http://api:4000/api

# In production behind HTTPS, set COOKIE_SECURE=true.
COOKIE_SECURE=false

# Nginx config selector: ./nginx/default.conf (HTTP only)
#                       or ./nginx/default-tls.conf (after certbot).
NGINX_CONF=./nginx/default.conf

# --- Database (Postgres 16) -------------------------------------------------
POSTGRES_DB=tms
POSTGRES_USER=tms
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://tms:CHANGE_ME_DB_PASSWORD@postgres:5432/tms

# --- Redis 7 ---------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# --- Object storage (MinIO / S3) -------------------------------------------
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=tms_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=tms
S3_REGION=us-east-1
# In compose, MinIO is reached via http://minio:9000. Override only for
# external S3 (AWS, Yandex Object Storage, Cloud.ru, etc.).
# S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost/storage

# --- Auth / JWT -------------------------------------------------------------
# Use 32+ random bytes. Generate: openssl rand -hex 32
# Shared between API (signs) and Next.js middleware (verifies via jose).
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_HEX_CHARS


# ============================================================
# 2. SECURITY HARDENING — defaults are dev-friendly. Tighten
#    these for production.
# ============================================================

# --- Rate limiting ---------------------------------------------------------
# Per-IP global limit on all API calls.
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=1 minute
# Stricter limit on /auth/login + /auth/signup to slow credential stuffing.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# --- Swagger / API docs ----------------------------------------------------
# Keep OFF in production to avoid leaking endpoint surface.
ENABLE_API_DOCS=false

# --- Seed data -------------------------------------------------------------
# Initial admin password set by `pnpm --filter @tms/api db:seed`.
# Required to seed; not used at runtime.
SEED_PASSWORD=CHANGE_ME_SEED_PASSWORD

# Demo data generator endpoint (/demo/generate) is admin-only by default.
# Set ALLOW_DEMO_SEED=true to expose it more broadly (e.g. for sandbox tenants).
# ALLOW_DEMO_SEED=false

# --- Logging ---------------------------------------------------------------
# pino structured logging level. trace | debug | info | warn | error | fatal.
LOG_LEVEL=info


# ============================================================
# 3. OPTIONAL INTEGRATIONS — adapters fall back to mock when
#    the env var is unset. Set these only when wiring real
#    third-party providers.
# ============================================================

# --- AI co-pilot (Anthropic Claude) ----------------------------------------
# Without this, the co-pilot endpoint returns mocked responses.
# ANTHROPIC_API_KEY=
# COPILOT_MODEL=claude-sonnet-4-5
# COPILOT_DAILY_LIMIT=200       # per-user message cap

# --- Email (SMTP) ----------------------------------------------------------
# Used for signup verification codes, password resets, notifications.
# When unset, emails are printed to console (provider=console).
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@tms.local

# --- Telegram bot ----------------------------------------------------------
# Driver chat notifications. Without these, notifications are no-op.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=


# ============================================================
# 4. CARRIER IDENTITY — appears on invoices, acts, waybills.
#    Required before issuing legally-valid documents to clients.
# ============================================================

# Internal-facing (API):
COMPANY_NAME=
COMPANY_INN=
COMPANY_KPP=

# Document carrier block (printed on PDFs):
CARRIER_NAME=
CARRIER_INN=
CARRIER_KPP=
CARRIER_ADDRESS=
CARRIER_PHONE=
CARRIER_BANK=
CARRIER_BIK=
CARRIER_ACCOUNT=
CARRIER_CORR=

# Web-facing duplicates (Next.js needs NEXT_PUBLIC_* prefix for client bundle):
NEXT_PUBLIC_CARRIER_NAME=
NEXT_PUBLIC_CARRIER_INN=
NEXT_PUBLIC_CARRIER_KPP=
NEXT_PUBLIC_CARRIER_ADDRESS=
NEXT_PUBLIC_CARRIER_BANK=
NEXT_PUBLIC_CARRIER_BIK=
NEXT_PUBLIC_CARRIER_ACCOUNT=


# ============================================================
# 5. TUNABLES — sensible defaults; override only if needed.
# ============================================================

# --- Cost model fallbacks (DB is authoritative; these are last-resort) -----
# Settings UI (/admin/settings) overrides these for every organization.
FUEL_PRICE_PER_LITER=60
DRIVER_SALARY_PER_HOUR=350
AMORTIZATION_PER_KM=5
FUEL_NORM_PER_100KM=30
BASE_OPERATIONAL_COST=500

# --- Timezone for displayed times -----------------------------------------
APP_TIMEZONE=Europe/Moscow

# --- Local uploads dir (dev only, when MinIO disabled) --------------------
# UPLOADS_DIR=./uploads

# --- API host:port (Fastify) ----------------------------------------------
# Defaults are correct inside the docker compose network.
# PORT=4000
# HOST=0.0.0.0
