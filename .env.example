# TMS v2 environment example
# Copy to .env and replace all CHANGE_ME values before production use.

# Public URL
TMS_PUBLIC_HOST=localhost
TMS_PUBLIC_SCHEME=http
DOMAIN=localhost
CORS_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
INTERNAL_API_URL=http://api:4000/api
COOKIE_SECURE=false
NGINX_CONF=./nginx/default.conf

# Database
POSTGRES_DB=tms
POSTGRES_USER=tms
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://tms:CHANGE_ME_DB_PASSWORD@postgres:5432/tms

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# API
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
LOG_LEVEL=info
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute
ENABLE_API_DOCS=false

# Seed
SEED_PASSWORD=CHANGE_ME_SEED_PASSWORD

# MinIO / S3-compatible storage
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=tms_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=tms
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost/storage
